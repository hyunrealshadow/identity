# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

.idea
.worktrees
node_modules

assets/static/css
assets/static/js
**/dist/**

ref

.trellis/workspace

# Conformance suite GitLab clone (built inside Docker image)
conformance/suite/
conformance/debug.log

# Python
__pycache__/

.env
.data/
apps/login/.data/

# Runtime-generated or operator-provided TLS material
/config/tls/*.key
/config/tls/*.crt
