# Rust build artifacts — largest offender, can be several GB
target/
debug/
**/*.rs.bk
*.pdb

# Local / secret configs never belong in the image
**/config/local.yaml
**/config/*.local.yaml
**/config/production.yaml
config/secrets/

# SQLite dev databases
*.sqlite
*.sqlite-*

# Frontend build artifacts (regenerated by the Tailwind CLI build stage)
assets/static/css
assets/static/js
# assets/views contains Tera templates required at runtime; do not ignore it.
**/dist/**

# Editor / IDE / tooling
.idea/
.opencode/
.worktrees/
.trellis/

# Node
node_modules/
**/node_modules/

# Git internals (large history is irrelevant inside the builder)
.git/
.gitignore

# Conformance test tooling — not part of the app
conformance/

# Docs & misc
ref/
docs/
*.md
