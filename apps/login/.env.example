IDENTITY_API_URL=https://127.0.0.1:5150
IDENTITY_INTERNAL_API_URL=https://127.0.0.1:5151
IDENTITY_PUBLIC_APP_URL=https://localhost:3000
# Static cookie sealing key, shared by every Login replica. Never rotated.
IDENTITY_LOGIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Workload credential for the Identity internal API: file or inline value.
# Must match Identity's internal.workloads.login (static token file or ServiceAccount).
IDENTITY_WORKLOAD_TOKEN_FILE=../../config/secrets/login-workload-token
# IDENTITY_WORKLOAD_TOKEN=replace-with-at-least-32-random-bytes
