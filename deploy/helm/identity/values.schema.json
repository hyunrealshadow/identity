{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["identity", "login"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["publicUrl", "tls", "database", "workload", "serviceAccount"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "publicUrl": { "type": "string", "pattern": "^https://" },
        "tls": {
          "type": "object",
          "required": ["enabled", "existingSecret", "certKey", "privateKeyKey", "trustedProxies"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string", "minLength": 1 },
            "certKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 },
            "trustedProxies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": false } } },
              "then": { "properties": { "trustedProxies": { "minItems": 1 } } }
            }
          ]
        },
        "database": {
          "type": "object",
          "required": ["existingSecret", "urlKey"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "urlKey": { "type": "string", "minLength": 1 }
          }
        },
        "workload": {
          "type": "object",
          "required": ["audience", "issuer", "expirationSeconds", "issuerCa", "issuerToken"],
          "properties": {
            "audience": { "type": "string", "minLength": 1 },
            "issuer": { "type": "string", "pattern": "^https://" },
            "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 86400 },
            "issuerCa": {
              "type": "object",
              "required": ["enabled", "configMapName", "key"],
              "properties": {
                "enabled": { "type": "boolean" },
                "configMapName": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "issuerToken": {
              "type": "object",
              "required": ["enabled", "expirationSeconds"],
              "properties": {
                "enabled": { "type": "boolean" },
                "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 86400 }
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        }
      }
    },
    "login": {
      "type": "object",
      "required": ["publicUrl", "tls", "sessionSecret", "internalCa"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "publicUrl": { "type": "string", "pattern": "^https://" },
        "tls": {
          "type": "object",
          "required": ["enabled", "existingSecret", "certKey", "privateKeyKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string", "minLength": 1 },
            "certKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "sessionSecret": {
          "type": "object",
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "internalCa": {
          "type": "object",
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "gatewayApi": {
      "type": "object",
      "required": ["enabled", "parentRef", "identity", "login"],
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRef": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        },
        "identity": {
          "type": "object",
          "required": ["enabled", "hostnames"],
          "properties": {
            "enabled": { "type": "boolean" },
            "hostnames": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "login": {
          "type": "object",
          "required": ["enabled", "hostnames"],
          "properties": {
            "enabled": { "type": "boolean" },
            "hostnames": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
