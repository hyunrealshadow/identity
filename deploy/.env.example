POSTGRES_PASSWORD=replace-with-a-random-database-password
IDENTITY_LOGIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

IDENTITY_PUBLIC_URL=https://identity.localhost:5150
LOGIN_PUBLIC_URL=https://identity.localhost:3000
IDENTITY_PORT=5150
LOGIN_PORT=3000

# Required only with docker-compose.upstream.yml. Use the CIDR from which the
# reverse proxy connects to the Identity container, not a public client range.
IDENTITY_TRUSTED_PROXY=

# Optional prebuilt images. The Compose file builds local images by default.
IDENTITY_IMAGE=identity:local
LOGIN_IMAGE=identity-login:local
